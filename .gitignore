# Data — hide entire data/. runs.db was version-controlled to ship demo history,
# but it is application state: every local run rewrites it, so it conflicted on
# every merge. Regenerate the demo history instead: scripts/seed_history.py.
# Login does not depend on it — verify_credentials() checks AUTH_USERNAME /
# AUTH_PASSWORD before the database, and the schema self-creates on first use.
data/*
eval/**/runtime/*.db

# Runtime-tunable detection thresholds: mutated by POST /api/v1/analysis/thresholds,
# so a tracked copy pins whatever a developer last tuned it to and silently
# overrides the code-level defaults in diagnostics_config.py for everyone who
# pulls it — including test isolation that monkeypatches those defaults.
data/diagnostics/thresholds.json


# Logs
# Anchored to the repo root: an unanchored `logs/` also swallowed the
# `app/api/runs/[runId]/logs/` route, and git cannot re-include a file whose
# parent directory is excluded. Build-cache logs live under .next/, ignored separately.
/logs/
*.log
frontend/*.log
.e2e-*.log

