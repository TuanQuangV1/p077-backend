azure_location             = "eastus"
environment                = "staging" # or "production"
app_name                   = "ai20krosbag"
domain_name                = "yourdomain.com"
backend_container_image    = "acrai20krosbagstaging.azurecr.io/backend:latest"
frontend_container_image   = "acrai20krosbagstaging.azurecr.io/frontend:latest"
backend_port               = 8000
frontend_port              = 3000
cpu                        = 0.5
memory                     = "1.0Gi"
cors_origins               = "https://staging.yourdomain.com"
enable_persistent_storage  = true
