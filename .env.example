# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# MODEL_NAME must be the OpenAI API model id (e.g. "gpt-4o-mini"), not a
# display name like "GPT-4o mini" — the latter fails every request with a
# 400 while `is_llm_configured()` still reports the provider as usable.
MODEL_NAME=gpt-4o-mini
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# LLM_LANGUAGE=vi  # vi = Vietnamese output, en = English (prompt stays English, only output language changes)
LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4.1  # alias for model_name

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Security (JWT 100%) ----
# JWT login credentials. API now uses 100% JWT (no static API_AUTH_TOKEN fallback).
# Set AUTH_USERNAME / AUTH_PASSWORD (or AUTH_PASSWORD_HASH) and JWT_SECRET.
# Every /api/v1 endpoint (except /auth/login and /auth/verify) requires
# `Authorization: Bearer <JWT>` (see POST /api/v1/auth/login).
# In non-production (development/test) when JWT_SECRET is empty, auth is bypassed (open).
# In production, missing JWT_SECRET fails closed with 503.
# API_AUTH_TOKEN=  # deprecated - removed in JWT mode, kept for env parsing compat
AUTH_USERNAME=admin
# Dev/demo password must match frontend "Điền demo" (admin/test-pass) and e2e auth.spec.ts
# Đổi thành mật khẩu mạnh khác khi deploy production
AUTH_PASSWORD=test-pass
# AUTH_PASSWORD_HASH=$2b$12$...  # bcrypt hash, if set takes precedence over AUTH_PASSWORD
JWT_SECRET=dev-insecure-jwt-secret-change-me-32-chars-minimum-length
JWT_EXPIRE_MINUTES=60
# Login rate limit (brute-force protection)
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_SEC=60
# Upload size limit in bytes (default 1 GiB). Raise for multi-GB rosbags
# (e.g. 8589934592 = 8 GiB covers the ~4.3 GB Navigation Test dataset).
# MAX_UPLOAD_BYTES=8589934592
# Sliding-window rate limit (default 120 req/min per IP).
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SEC=60
# Trust proxy for X-Forwarded-For (set 1 when behind nginx with $proxy_add_x_forwarded_for).
# TRUST_PROXY=1
# Number of trusted proxy hops to peel from the right of X-Forwarded-For.
# Use 1 for single nginx, 2 if an L4 LB sits in front of nginx (otherwise all
# external clients collapse into one bucket via the LB's internal IP).
# TRUST_PROXY_HOPS=1

# ---- Persistence ----
# SQLite file backing analysis runs / review queue (default data/runs.db).
# RUN_DB_PATH=data/runs.db
# Diagnostics thresholds file (default data/diagnostics/thresholds.json).
# DIAGNOSTICS_THRESHOLDS_FILE=data/diagnostics/thresholds.json

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
