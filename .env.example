# ============================================
# RAV-13 — Environment Variables
# ============================================
# Copy to .env and fill in. NEVER commit .env.
# Every key here maps to src/config.py (Settings) or an os.environ read in
# src/. Unknown keys are ignored (pydantic extra="ignore").

# ---- App ----
APP_ENV=development           # development | staging | production | test
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ---- CORS ----
# Comma-separated allowlist of frontend origins. In production a literal "*"
# is rejected at startup (it still echoes every Origin under allow_credentials).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for origins that can't be enumerated (Vercel preview deploys):
# CORS_ORIGIN_REGEX=https://p077-[a-z0-9-]+\.vercel\.app

# ---- Auth (100% JWT) ----
# Every /api/v1 endpoint except /auth/login, /auth/signup and /auth/verify
# needs `Authorization: Bearer <JWT>` (get one from POST /api/v1/auth/login).
# In development/test an empty JWT_SECRET bypasses auth entirely (open API).
# In production AND staging a missing JWT_SECRET fails closed with 503.
AUTH_USERNAME=admin
# Dev/demo password — must match the frontend "Điền demo" button and e2e
# auth.spec.ts (admin / test-pass). Use a strong value in production.
AUTH_PASSWORD=test-pass
# AUTH_PASSWORD_HASH=$2b$12$...   # bcrypt hash; if set, takes precedence over AUTH_PASSWORD
# Minimum 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# ---- LLM ----
# MODEL_NAME must be the provider's API model id (e.g. gpt-4o-mini), never a
# display name — a display name 400s every request while is_llm_configured()
# still reports the provider as usable.
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_NAME=claude-sonnet-4-5
LLM_LANGUAGE=vi               # vi | en  (output language only; prompt stays English)
LLM_TEMPERATURE=0.2
# Output token cap per completion (cost guard, LLM10). Applies to both providers.
LLM_MAX_TOKENS=2048

# ---- Persistence ----
# RUN_DB_PATH=data/runs.db                              # SQLite: runs, anomalies, ai_results, review queue, auth users, jwt blacklist
# RUN_DB_WAL=1                                          # enable WAL journal mode (recommended for the server)
# DIAGNOSTICS_THRESHOLDS_FILE=data/diagnostics/thresholds.json
# HILT_DIR=data/hilt

# ---- Uploads & rate limiting ----
# MAX_UPLOAD_BYTES=1073741824                           # 1 GiB default; raise for multi-GB rosbags
# RATE_LIMIT_MAX_REQUESTS=120                           # sliding window per IP
# RATE_LIMIT_WINDOW_SEC=60
# LOGIN_RATE_LIMIT_MAX=5                                # stricter window for /auth/login and /auth/signup
# LOGIN_RATE_LIMIT_WINDOW_SEC=60
# TRUST_PROXY=1                                         # honour X-Forwarded-For (set when behind nginx)
# TRUST_PROXY_HOPS=1                                    # proxy hops to peel: 1 for a single nginx, 2 with an L4 LB in front

# ---- Diagnostics tuning ----
# EXPERIMENTS_CACHE_TTL_SEC=120
# PERF_SLOW_REQUEST_MS=1000
# PERF_SLOW_QUERY_MS=50

# ---- HILT (human-in-the-loop iterative debug) ----
# HILT_MAX_ITERATIONS=5
# HILT_UNCERTAINTY_THRESHOLD=0.5
# HILT_LOOP_SIMILARITY_THRESHOLD=0.85
# HILT_MAX_FAILURES=3
# HILT_EXPERT_EMAIL=

# ---- Frontend (Next.js) ----
# Only needed when the browser must reach the backend directly (large multipart
# uploads bypass the /api/v1 rewrite proxy). Otherwise every call is same-origin.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Dev tooling: AI hook logging (instructor-provided, not used by the app) ----
# Logs AI-assisted development activity to .ai-log/. Course deliverable, no
# runtime effect on the service.
# AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# AI_LOG_API_KEY=your-ai-log-api-key-here
# AI_LOG_DIR=.ai-log
