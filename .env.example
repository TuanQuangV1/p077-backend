# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Security ----
# Optional API token. When set, every /api/v1 endpoint requires
# `Authorization: Bearer <token>`. Leave empty in development.
# API_AUTH_TOKEN=
# Upload size limit in bytes (default 1 GiB). Raise for multi-GB rosbags
# (e.g. 8589934592 = 8 GiB covers the ~4.3 GB Navigation Test dataset).
# MAX_UPLOAD_BYTES=8589934592
# Sliding-window rate limit (default 120 req/min per IP).
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SEC=60

# ---- Persistence ----
# SQLite file backing analysis runs / review queue (default data/runs.db).
# RUN_DB_PATH=data/runs.db
# Diagnostics thresholds file (default data/diagnostics/thresholds.json).
# DIAGNOSTICS_THRESHOLDS_FILE=data/diagnostics/thresholds.json

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
